// out: 1
// out: 2
// out: Fizz
// out: 4
// out: Buzz
// out: Fizz
// out: 7
// out: 8
// out: Fizz
// out: Buzz
// out: 11
// out: Fizz
// out: 13
// out: 14
// out: FizzBuzz
fn fizz(n: Int) -> Text {
    if n % 15 == 0 { "FizzBuzz" }
    else if n % 3 == 0 { "Fizz" }
    else if n % 5 == 0 { "Buzz" }
    else { n.to_text() }
}

fn main() {
    for i in 1..=15 {
        print(fizz(i))
    }
}
